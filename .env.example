GROQ_API_KEY=your_api_key_here

# Optional. When set, the API requires this value in the X-API-Key header and the
# Streamlit UI sends it automatically. Leave empty for an open local API.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANYDOC_API_KEY=

# Optional rate limits (0 disables a limit).
# RATE_LIMIT_QUERIES_PER_MIN=20
# RATE_LIMIT_WRITES_PER_HOUR=30
# RATE_LIMIT_EVALS_PER_HOUR=3
